# ========================================
# Marketplace-Web - Using Pre-built dist
# Build locally, then use this Dockerfile
#
# El dist debe generarse con VITE_AGREEMENT_ID del convenio CO-CREA, ej:
#   cd apps/marketplace-web
#   VITE_AGREEMENT_ID=b7a6d812-5dd7-4d7b-bec4-687d65234f4f npm run build
#   cp -r dist ../../experiments/cocrea/marketplace-build
# ========================================

FROM nginx:alpine

# Copy pre-built files from local build
COPY marketplace-build /usr/share/nginx/html

# Config de nginx con fallback SPA (sin esto, recargar una ruta profunda da 404)
COPY nginx-spa.conf /etc/nginx/conf.d/default.conf

# Expose port
EXPOSE 80

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
